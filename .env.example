# Copy to .env and adjust. Never commit .env.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# With DJANGO_DEBUG=false the site redirects to HTTPS. Set false only when no TLS
# proxy is in front yet (e.g. trying docker compose on http://localhost:8000).
DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# PostgreSQL (leave POSTGRES_DB empty to use SQLite). docker-compose.yml uses these too.
POSTGRES_DB=
POSTGRES_USER=qfgate
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Background schedule (python manage.py run_worker)
MARKET_SYNC_EVERY_MINUTES=15
MARKET_DAILY_AT_UTC=00:05
MARKET_KEEP_JOBS_DAYS=14

# Market data
# 365 keeps a rolling year of 1m history (about 50 MB of trade archive per month per coin)
MARKET_HISTORY_DAYS=60
# Day boundary for daily high/low. UTC matches Gate.io 1d candles and the sample sheet.
MARKET_DAY_TIMEZONE=UTC
MARKET_DEFAULT_QUOTE=USDT
MARKET_VERIFY_ON_SAVE=true

# Phase 4 only (automated trading). Use a key with TRADE permission only,
# NO withdrawal permission, and IP-whitelisted to your server.
GATE_API_KEY=
GATE_API_SECRET=

# --- Bots, alerts, live trading (Phase 4) ---
# Live orders need ALL of: LIVE_TRADING=true, the two Gate keys, and "Live trading" switched on in Control.
# Use a Gate API key with SPOT TRADE permission only, IP-whitelisted to your server, never withdrawals.
LIVE_TRADING=false
# GATE_API_KEY=
# GATE_API_SECRET=
# --- Portfolio ledger (Phase 9): import your real Gate.io history ---
# A SEPARATE read-only key: spot + wallet READ permission only. No trading, no withdrawals.
# GATE_READ_API_KEY=
# GATE_READ_API_SECRET=
# How far back the first import walks (30 days per request); older trades can't be fetched before this.
# LEDGER_HISTORY_START=2017-01-01
# Telegram alerts + commands: create a bot with @BotFather, then put your own chat id here.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Optional: comma-separated URLs that receive a JSON POST for every alert (Discord, Slack, your service).
# WEBHOOK_URLS=

# --- Signal sharing (Phase 6) ---
# Publish this instance's signals to other instances that present this token (leave empty = off).
# SIGNAL_API_TOKEN=
# Token of another instance you follow with manage.py follow_signals.
# REMOTE_SIGNAL_TOKEN=
