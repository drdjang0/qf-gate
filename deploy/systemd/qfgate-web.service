[Unit]
Description=QF-gate web (gunicorn)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=qfgate
Group=qfgate
WorkingDirectory=/srv/qfgate/app
EnvironmentFile=/srv/qfgate/app/.env
ExecStart=/srv/qfgate/venv/bin/gunicorn qfgate.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 120
Restart=always
RestartSec=5
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
