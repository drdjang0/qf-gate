[Unit]
Description=QF-gate fill listener (Gate.io private WebSocket: order fills and trades for every user's key)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=qfgate
Group=qfgate
WorkingDirectory=/srv/qfgate/app
EnvironmentFile=/srv/qfgate/app/.env
ExecStart=/srv/qfgate/venv/bin/python manage.py stream_account
Restart=always
RestartSec=5
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
