[Unit]
Description=QF-gate live 1m stream
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=qfgate
Group=qfgate
WorkingDirectory=/srv/qfgate/app
EnvironmentFile=/srv/qfgate/app/.env
ExecStart=/srv/qfgate/venv/bin/python manage.py stream_candles
Restart=always
RestartSec=5
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
